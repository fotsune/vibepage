# ═══════════════════════════════════════════════════════════════════
#  Home — образец конфига: каждая секция по разу, все ключи, дефолты
#
#  Скопировать в config/homepage.toml (или в любой *.toml из config_path).
#  Формат TOML-like: значение можно без кавычек (кавычки нужны при
#  пробелах, запятой и «#»); списки — "a, b" или ["a", "b"]; ${VAR} и
#  ${VAR:-запасное} берутся из config/.env или из окружения процесса;
#  «#» после пробела — комментарий, color = #8be9fd остаётся цветом.
#
#  В конце строки: ОБЯЗ — ключ нужен; «необяз · X» — что будет без него.
#  Главный конфиг читается последним, поэтому его [system] побеждает
#  [system] из файлов config_path.
# ═══════════════════════════════════════════════════════════════════


# общие настройки
[system]
title = "Home"                  # необяз · "Homepage"
icon_path = "icons"             # необяз · каталог icons рядом с конфигом
config_path = "conf.d"          # необяз · без доп. файлов; папка, список или маска
cols = 3                        # необяз · 3, минимум 1 — столбцов с группами на десктопе
mobile_cols = 1                 # необяз · 1 — столбцов на узком экране (≤ 900px)
open_in_new_page = false        # необяз · false — значение new_page для всех сервисов
state_interval = 10             # необяз · 10, минимум 3 — как часто страница спрашивает
                                # /api/state, секунд (старое имя ключа — poll)
group_cols = 3                  # необяз · 3 — столбцов карточек в группе, 0 — сколько влезет


# верхняя панель; любой ключ можно писать и в [system]
[header]
show = true                     # необяз · true — вся шапка (алиасы: header, enabled)
desc = "self-hosted dashboard"  # необяз · "self-hosted dashboard"; "" скрывает подпись
                                # (алиасы: tagline, subtitle)
time = true                     # необяз · true — часы
time_format = 12                # необяз · 12; 24 — сутки
search = true                   # необяз · true — строка поиска и горячая клавиша «/»
icon = "home.svg"               # необяз · нет — файл из icon_path (svg инлайном),
                                # "mdi:home" / "sdi:home" или URL
favicon = "favicon.svg"         # необяз · нет — иконка вкладки, тоже из icon_path
link_mode = "auto"              # необяз · auto — какую ссылку открывать: auto (локально
                                # alt, снаружи link), main (всегда link), alt (всегда alt);
                                # старое имя ключа — main_alt


# группа карточек; имя секции — её identity, name — подпись
[group:Main]
name = "Мои сервисы"           # необяз · имя секции
priority = 1                    # необяз · в свободный столбец — это НОМЕР СТОЛБЦА (1 — левый)
color = "cyan"                  # необяз · акцент по имени группы; имя палитры Dracula
                                # (purple, pink, cyan, green, orange, yellow, red, comment),
                                # #hex или "имя/#hex"
cols = 3                        # необяз · system.group_cols — столбцов карточек в группе,
                                # 0 — сколько влезет
# link = "Other"                # необяз · объединить с группой Other: тот же столбец,
                                # сразу под ней
# Группу Default можно не описывать — сервисы без group попадают туда.


# карточка; имя секции — identity, name — подпись
[service:Example]
name = "Пример"                 # необяз · имя секции
link = "https://example.com"    # необяз · нет — основная ссылка
alt = "http://192.168.1.10:3000" # необяз · нет — вторая (локальная) ссылка;
                                # без link и alt карточка никуда не ведёт, но рисуется
icon = "mdi:server"             # необяз · плейсхолдер с первой буквой; icon главнее icon_link
icon_link = "https://example.com/logo.png"  # необяз · нет — внешняя картинка
icon_color = "cyan"             # необяз · акцент группы
desc = "Все ключи карточки"    # необяз · нет — подпись под названием
group = "Main"                  # необяз · Default
priority = 1                    # необяз · по имени — порядок внутри группы, меньше — выше
new_page = true                 # необяз · system.open_in_new_page
widget = "cpu"                  # необяз · пусто — секции [widget:…] через запятую,
                                # каждая следующая стопкой, максимум 4 поля на виджет
ping = "1.1.1.1:443"            # необяз · нет точки — точка статуса: host или host:port
                                # (TCP-подключение, порт по умолчанию 443)
ping_timeout = 2                # необяз · 2 — секунд на попытку


# ═══════════════════════════════════════════════════════════════════
#  [widget:Имя] — живое состояние карточки; service.widget ссылается на
#  имя секции. Общие ключи у всех типов (ключи самого типа — ниже):
#    type = portainer                     # что спрашивать; можно опустить
#                                          # вместе с host + external
#    fields = "running, total"            # необяз · все поля типа и в их
#                                          # порядке; сверх четырёх — отброшено
#    timeout = 4                           # необяз · 4 — секунд на запрос
#    verify_tls = false                    # необяз · false — самоподписанный
#                                          # сертификат принимается
#    host = "192.168.0.112:24556"        # необяз · взять готовый виджет с
#    external = "portainer"               # соседнего дашборда (host — его
#                                          # адрес, external — имя [widget:…]
#                                          # у него); тип тогда придёт оттуда
#  Пока на виджет никто не ссылается, он никуда не ходит: объявить можно
#  все сразу.
# ═══════════════════════════════════════════════════════════════════

# контейнеры Docker через API Portainer
[widget:portainer]
type = portainer
url = "https://192.168.0.112:9000"  # ОБЯЗ — база API
key = "${PORTAINER_KEY:-token}"     # ОБЯЗ — API-ключ (My account → Access tokens)
env = 1                              # необяз · 1 — номер endpoint (окружения)
# fields = "running, stopped, total" # необяз · все поля: running, stopped, total
# host = "192.168.0.112:24556"      # external-режим: адрес соседа (http:// добавится)
# external = "portainer"            # …и имя секции [widget:…] у него

# /control/stats у AdGuard Home
[widget:adguard]
type = adguard
url = "http://192.168.0.11:8080"    # ОБЯЗ
username = "${ADGUARD_USERNAME:-admin}"   # необяз · без входа, если API открыт
password = "${ADGUARD_PASSWORD:-}"        # необяз · то же
# fields = "queries, blocked, filtered, latency"   # необяз · все поля
# host = "192.168.0.11:24556"
# external = "adguard"

# Nginx Proxy Manager
[widget:npm]
type = npm
url = "http://192.168.0.11:81"                    # ОБЯЗ
username = "${NPM_USERNAME:-admin@example.com}"   # ОБЯЗ — e-mail
password = "${NPM_PASSWORD:-change-me}"           # ОБЯЗ
# fields = "enabled, disabled, total"             # необяз · все поля
# host = "192.168.0.11:24556"
# external = "npm"

# статус Minecraft-сервера по UDP
[widget:minecraft]
type = minecraft
url = "192.168.0.11:25565"          # ОБЯЗ — host:port или udp://host:port
# fields = "status, players, version"   # необяз · все поля
# host = "192.168.0.11:24556"
# external = "minecraft"

# наблюдения за страницами (changedetection.io)
[widget:changedetection]
type = changedetectionio
url = "http://192.168.0.11:5000"     # ОБЯЗ
key = "${CHANGEDETECTION_KEY:-key}"  # ОБЯЗ — Settings → API
# fields = "diffsDetected, totalObserved"   # необяз · все поля
# host = "192.168.0.11:24556"
# external = "changedetection"

# страница статуса Uptime Kuma
[widget:uptimekuma]
type = uptimekuma
url = "http://192.168.0.11:3001"     # ОБЯЗ
slug = "main"                        # ОБЯЗ — адрес страницы статуса
# fields = "up, down, uptime, incident"   # необяз · все поля
# host = "192.168.0.11:24556"
# external = "uptimekuma"

# статистика прослушиваний Your Spotify
[widget:spotify]
type = yourspotify
url = "${YOURSPOTIFY_URL:-http://192.168.0.11:8000}"   # ОБЯЗ
key = "${YOURSPOTIFY_KEY:-key}"                       # ОБЯЗ — ключ пользователя
interval = week                       # необяз · week; day, month, year, all
# fields = "songs, time, artists"     # необяз · все поля
# host = "192.168.0.11:24556"
# external = "spotify"

# метрики Watchtower (/v1/metrics)
[widget:watchtower]
type = watchtower
url = "http://192.168.0.11:8081"      # ОБЯЗ
key = "${WATCHTOWER_KEY:-token}"      # ОБЯЗ — WATCHTOWER_HTTP_API_TOKEN
# fields = "containers_scanned, containers_updated, containers_failed"  # необяз · все поля
# host = "192.168.0.11:24556"
# external = "watchtower"

# сам хост, где живёт dashboard (в контейнере — контейнер)
[widget:cpu]
type = cpu                           # старое имя sysinfo — то же самое
tempmin = 0                          # необяз · 0 — нижняя граница шкалы температуры
tempmax = 100                        # необяз · 100 — верхняя
units = metric                        # необяз · metric; imperial — только для температуры
# fields = "cpu, cputemp, uptime"    # необяз · все поля
# host = "192.168.0.11:24556"
# external = "cpu"

# оперативная память хоста
[widget:ram]
type = ram
ramunits = bytes                      # необяз · bytes (GB, 1000); bbytes — GiB (1024)
# fields = "free, consumed, total"    # необяз · все поля
# host = "192.168.0.11:24556"
# external = "ram"

# свободное место; несколько путей складываются в одно число
[widget:disk]
type = disk
disk = "/"                            # ОБЯЗ — пути: "/", "/mnt/data"; на windows "C:\, D:\"
diskunits = bytes                     # необяз · bytes (GB); bbytes — GiB
name = "System"                       # необяз · подпись виджета; без неё — сами пути
# fields = "free, consumed, total"    # необяз · все поля
# host = "192.168.0.11:24556"
# external = "disk"
