# Скопируйте в config/.env (не в git) и заполните: эти значения подставит ${VAR}
# в конфиге. Переменные, уже заданные в окружении, главнее этого файла.
# Значение — всё после первого «=», поэтому комментарий пишите отдельной строкой.

# Portainer: API-ключ (My account → Access tokens)
PORTAINER_KEY=

# AdGuard Home: логин и пароль веб-интерфейса
ADGUARD_USERNAME=admin
ADGUARD_PASSWORD=

# Nginx Proxy Manager: e-mail и пароль
NPM_USERNAME=
NPM_PASSWORD=

# changedetection.io: Settings → API
CHANGEDETECTION_KEY=

# Watchtower: WATCHTOWER_HTTP_API_TOKEN
WATCHTOWER_KEY=

# Your Spotify: адрес API и ключ пользователя
YOURSPOTIFY_URL=
YOURSPOTIFY_KEY=

# qBittorrent: логин веб-интерфейса (ключ API — Настройки → Web UI → API keys)
QBT_USERNAME=
QBT_PASSWORD=
QBT_KEY=

# Navidrome: user, token = md5(пароль + salt), salt
NAVIDROME_USER=
NAVIDROME_TOKEN=
NAVIDROME_SALT=
